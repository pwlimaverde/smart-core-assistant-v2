# ==============================================================================
# Smart Core Assistant v2 — Variáveis de Ambiente
# ==============================================================================
# Copie este arquivo para ".env" e preencha com os valores reais.
#
# Para desenvolvimento local com túnel SSH:
#   1. Preencha as chaves e credenciais em "infra/.env.deploy"
#   2. Inicie o túnel: cd infra && .\tunnel.ps1 (mantenha o terminal aberto)
#   3. Use "localhost" como host nas conexões
# ==============================================================================

# ── Banco de Dados (PostgreSQL + pgvector) ────────────────────────────────────
# URL de conexão para a aplicação comum (menor privilégio)
DATABASE_URL=postgresql://smartcore_app:SENHA@localhost:5434/smartcore_v2

# URL de conexão do administrador (necessária para rodar migrations que instalam extensões)
DATABASE_ADMIN_URL=postgresql://smartcore_admin:SENHA@localhost:5434/smartcore_v2

# ── Redis (Barramento & Cache) ────────────────────────────────────────────────
REDIS_URL=redis://:SENHA@localhost:6380/0

# ── Storage de Mídia (S3-compatible) ──────────────────────────────────────────
# Opção 1: MinIO (Desenvolvimento Local / Tunnel)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=smartcore_minio
S3_SECRET_ACCESS_KEY=SENHA_MINIO
S3_BUCKET=smartcore-media
S3_FORCE_PATH_STYLE=true

# Opção 2: Cloudflare R2 (Produção)
# S3_ENDPOINT=https://f8a62f80a11daa28993d717489ff83a9.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=CHAVE_DE_ACESSO_R2
# S3_SECRET_ACCESS_KEY=CHAVE_SECRETA_R2
# S3_BUCKET=media-smart-core-assistant
# S3_FORCE_PATH_STYLE=true

# ── Criptografia & Sessão ─────────────────────────────────────────────────────
# Chave AES-256 (32 bytes em hex) usada para encriptar chaves de API externas no banco
# Gerar com: openssl rand -hex 32
ENCRYPTION_KEY=

# Segredo para assinatura dos tokens JWT da aplicação (mínimo de 64 caracteres)
# Gerar com: openssl rand -base64 64
JWT_SECRET=

# ── Transporte UDS (Unix Domain Sockets) ──────────────────────────────────────
# Caminhos para os sockets locais usados na comunicação gRPC inter-serviços
# No Windows/Desenvolvimento local, use conexões TCP normais ou portas gRPC.
# No Linux (Servidor DEV/PROD), aponte para os caminhos de socket apropriados:
# DEV:  /run/smartcore-dev/data_postgres.sock, etc.
# PROD: /run/smartcore/data_postgres.sock, etc.
SMARTCORE_DATA_POSTGRES_ENDPOINT=unix:/run/smartcore/data_postgres.sock
SMARTCORE_DATA_REDIS_ENDPOINT=unix:/run/smartcore/data_redis.sock
SMARTCORE_DATA_STORAGE_ENDPOINT=unix:/run/smartcore/data_storage.sock
SMARTCORE_CONTROL_PLANE_ENDPOINT=unix:/run/smartcore/control_plane.sock
SMARTCORE_MESSAGING_GATEWAY_ENDPOINT=unix:/run/smartcore/messaging_gateway.sock

# ── runtime_api ───────────────────────────────────────────────────────────────
# Endpoint próprio do gateway, lido por Server::from_env("RUNTIME_API").
# Se ausente, o binário cai num default hardcoded (/var/run/smartcore/RUNTIME_API.sock),
# furando o isolamento por ambiente — SEMPRE defina por ambiente:
#   DEV:  unix:/run/smartcore-dev/runtime_api.sock
#   PROD: unix:/run/smartcore/runtime_api.sock
SMARTCORE_RUNTIME_API_ENDPOINT=unix:/run/smartcore/runtime_api.sock
# NOTA: o gateway gRPC público (TCP 8090 atrás do Caddy em *-api.smartcoreassistant.com.br)
# depende da feature F6 (Auth/runtime_api) e ainda NÃO está implementado. As antigas vars
# RUNTIME_API_GRPC_PORT/RUNTIME_API_GRPC_LISTEN não são lidas pelo binário (removidas).

# ── Observabilidade & Logs ────────────────────────────────────────────────────
# Nível de log do Rust (trace, debug, info, warn, error)
RUST_LOG=info

# Endpoint do OpenTelemetry Collector para envio de traces/logs/métricas
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Namespace do serviço (usado para diferenciar traces no Grafana/Tempo)
# DEV:  smartcore-dev
# PROD: smartcore-prod
OTEL_SERVICE_NAMESPACE=smartcore-prod

# ── Grafana (stack de observabilidade LGTM) ───────────────────────────────────
# Credenciais do admin do Grafana, consumidas por docker/compose/observability.yml.
# Defina valores fortes no .env do servidor antes de subir a stack.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ── Envio de E-mail (SMTP via Brevo) ──────────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=exemplo@smartcoreassistant.com.br
SMTP_PASSWORD=SENHA_DO_RELAY
FROM_EMAIL=no-reply@smartcoreassistant.com.br
