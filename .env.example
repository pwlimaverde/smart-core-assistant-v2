# ============================================
# Smart Core Assistant v2 — Variaveis de Ambiente
# ============================================
# Copie para .env e preencha com os valores reais.
#
# Para desenvolvimento com banco no Hostinger:
#   1. Preencha as senhas em infra/.env.deploy
#   2. Execute: cd infra && .\tunnel.ps1  (mantenha aberto)
#   3. Use localhost como host abaixo
# ============================================

# ============================================
# PostgreSQL (via tunnel SSH: cd infra && .\tunnel.ps1)
# ============================================
DATABASE_URL=postgresql://smartcore_app:SENHA@localhost:5434/smartcore_v2

# ============================================
# Redis (via tunnel SSH)
# ============================================
REDIS_URL=redis://:SENHA@localhost:6380

# ============================================
# Storage de Midia (S3-compatible: MinIO em dev / Cloudflare R2 em prod)
# Crate: infrastructure_storage (ver doc_dev/planejamento/06-infraestrutura-storage.md)
# ============================================
# --- DEV: MinIO local via tunnel SSH ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=smartcore_minio
S3_SECRET_ACCESS_KEY=SENHA
S3_BUCKET=smartcore-media
S3_FORCE_PATH_STYLE=true

# --- PROD: Cloudflare R2 (descomente e use no ambiente de producao) ---
# S3_ENDPOINT=https://f8a62f80a11daa28993d717489ff83a9.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>       # gerar em R2 > Manage R2 API Tokens
# S3_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
# S3_BUCKET=media-smart-core-assistant
# S3_FORCE_PATH_STYLE=true

# ============================================
# Seguranca
# ============================================

# Chave AES-256 para criptografia de API keys no banco (32 bytes em hex)
# Gerar: openssl rand -hex 32
ENCRYPTION_KEY=

# Segredo JWT para assinar/verificar tokens (minimo 64 chars)
# Gerar: openssl rand -base64 64
JWT_SECRET=

# ============================================
# ia_engine Python (gRPC — apenas para worker)
# ============================================
IA_ENGINE_URL=http://localhost:50051

# ============================================
# Aplicacao
# ============================================
RUST_LOG=info
