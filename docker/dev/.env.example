# Ambiente DEV — copie para .env e preencha os segredos (este .env real NAO vai pro git).
SERVER_IMAGE=ghcr.io/pwlimaverde/smart-core-assistant-v2/smartcore-server:dev
WEB_IMAGE=ghcr.io/pwlimaverde/smart-core-assistant-v2/smartcore-web:dev
# Porta gRPC-Web publicada no host (o edge faz reverse_proxy p/ host.docker.internal:50051).
RUNTIME_WEB_PORT=50051
# Porta do client web publicada no host (o edge proxia /v2/admin -> esta porta).
WEB_HOST_PORT=8081

# Config dos CONTAINERS de dados
POSTGRES_DB=smartcore_v2
# smartcore_app é o bootstrap user do container Postgres — o Postgres SEMPRE o
# torna SUPERUSER e proíbe removê-lo ("the bootstrap user must have the SUPERUSER
# attribute"). Por isso ele continua sendo a role ADMINISTRATIVA (DDL/migrations),
# inalterado — ver DATABASE_ADMIN_URL abaixo.
POSTGRES_USER=smartcore_app
POSTGRES_PASSWORD=__PREENCHER_NO_SERVIDOR__
# N4.1: senha da NOVA role de runtime smartcore_app_rt (NOSUPERUSER NOBYPASSRLS),
# criada de forma aditiva por infra/provision-db-role.sh — é ela quem passa de
# verdade pelas policies de RLS (destrava o RLS de verdade).
APP_RT_PASSWORD=__PREENCHER_NO_SERVIDOR__
REDIS_PASSWORD=__PREENCHER_NO_SERVIDOR__
MINIO_ROOT_USER=__PREENCHER_NO_SERVIDOR__
MINIO_ROOT_PASSWORD=__PREENCHER_NO_SERVIDOR__

# URLs lidas pelos APPS (host = DNS do compose).
# DATABASE_URL (runtime de negócio) usa smartcore_app_rt — role restrita, criada
# por infra/provision-db-role.sh, sujeita de verdade às policies de RLS.
# DATABASE_ADMIN_URL (DDL/migrations/lookups cross-tenant) usa smartcore_app — o
# bootstrap user do container, sempre SUPERUSER, inalterado.
# ANTES de rodar infra/provision-db-role.sh pela 1a vez, aponte DATABASE_URL
# também para smartcore_app (mesma senha de POSTGRES_PASSWORD) — smartcore_app_rt
# só existe depois do script criar a role.
DATABASE_URL=postgresql://smartcore_app_rt:__PREENCHER_NO_SERVIDOR__@postgres:5432/smartcore_v2
DATABASE_ADMIN_URL=postgresql://smartcore_app:__PREENCHER_NO_SERVIDOR__@postgres:5432/smartcore_v2
REDIS_URL=redis://:__PREENCHER_NO_SERVIDOR__@redis:6379/0
REDIS_BUS_URL=redis://:__PREENCHER_NO_SERVIDOR__@redis-bus:6379/0

# Transport TCP entre os servicos (DNS do compose)
SMARTCORE_DATA_POSTGRES_ENDPOINT=tcp://data_postgres:9101
SMARTCORE_DATA_REDIS_ENDPOINT=tcp://data_redis:9102
SMARTCORE_DATA_STORAGE_ENDPOINT=tcp://data_storage:9103
SMARTCORE_CONTROL_PLANE_ENDPOINT=tcp://control_plane:9104
SMARTCORE_RUNTIME_API_ENDPOINT=tcp://runtime_api:9106
# ia_engine fala gRPC HTTP/2 de verdade (tonic), diferente do protocolo interno
# transport::MuxClient (tcp://) usado pelos demais serviços Rust acima — por isso
# o esquema aqui é http://, não tcp://.
SMARTCORE_IA_ENGINE_ENDPOINT=http://ia_engine:50060
RUNTIME_API_GRPC_WEB_ADDR=0.0.0.0:50051

# ---- Configuração do processo ia_engine (lida por pydantic-settings) ----
# O ia_engine também consome REDIS_URL (definida acima): é de lá que ele lê a
# config resolvida de cada tenant (`tenant:config:<uuid>`, publicada pelo
# data_postgres) e escuta o canal de invalidação. Ele NUNCA fala com o Postgres.
# Use a instância de cache (REDIS_URL), não a de barramento (REDIS_BUS_URL).
# Ambiente reportado nos spans (`deployment.environment`). Sem esta variável o
# default do Settings é "dev" — em prod os traces do ia_engine sairiam rotulados
# como dev, misturados com os do ambiente de desenvolvimento.
SMARTCORE_ENV=dev
# KILL-SWITCH GLOBAL da transcrição de áudio (custo/latência). Independente da
# cascata por tenant do lado Rust (`tenants_tenantconfig` > CoreSetting
# TRANSCRIPTION_ENABLED): com esta OFF, o RPC Transcribe curto-circuita e devolve
# resposta VAZIA SEM ERRO, mesmo que o tenant tenha ligado a transcrição no
# painel. Ligue aqui também ao habilitar transcrição para qualquer tenant.
TRANSCRIPTION_ENABLED=false

# Storage de midia: DEV usa MinIO local
S3_ENDPOINT=http://minio:9000
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
S3_BUCKET=media-smart-core-assistant
S3_ACCESS_KEY_ID=__PREENCHER_NO_SERVIDOR__
S3_SECRET_ACCESS_KEY=__PREENCHER_NO_SERVIDOR__
# N4.3: lifecycle do bucket (defesa em profundidade da retenção de mídia) — margem
# generosa sobre a política padrão (~30d); best-effort, não bloqueia o boot.
S3_LIFECYCLE_EXPIRATION_DAYS=90

# Observabilidade (namespace separa dev/prod na stack compartilhada)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAMESPACE=smart-core-v2-dev
RUST_LOG=info

# Segredos
JWT_SECRET=__PREENCHER_NO_SERVIDOR__
ENCRYPTION_KEY=__PREENCHER_NO_SERVIDOR__

# Evolution API & WhatsApp
EVOLUTION_API_URL=http://smartcore-evolution:8080
EVOLUTION_GLOBAL_API_KEY=__PREENCHER_NO_SERVIDOR__
# Porta do HOST para o webhook_ingress (o container ouve fixo em 9200 internamente;
# evolution -> webhook_ingress é via rede interna, então esta porta é só p/ acesso
# externo/debug). DEVE ser uma porta livre no servidor — no host compartilhado a 9200
# já está em uso por outro projeto, então o dev.env do servidor usa 9210.
WEBHOOK_INGRESS_PORT=9200
# Stack FUNDACIONAL do evolution (docker/evolution) — o deploy sobe essa stack a
# partir DESTE mesmo dev.env. Necessário para criar a rede externa
# `smart_core_v2_evolution_net` que data_whatsapp/webhook_ingress consomem.
EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=__PREENCHER_NO_SERVIDOR__
# Porta do HOST para a Evolution API (mapeia para 8080 do container). O app acessa
# via rede interna (smartcore-evolution:8080), então esta porta é só p/ acesso
# externo/debug — DEVE ser uma porta livre no servidor (8080/8081 já estão em uso).
EVOLUTION_PORT=8082

# Endpoint gRPC do data_whatsapp para comunicação inter-serviços
SMARTCORE_DATA_WHATSAPP_ENDPOINT=tcp://data_whatsapp:9107

# N4.2: enforcement de quota/inadimplência — nasce log-only (false); promover a
# true só depois de validar que não há falso positivo barrando tenant legítimo.
SMARTCORE_QUOTA_ENFORCE=false

# N4.4: rate limiting amplo (além do login). "MAX" tentativas por "WINDOW_S".
WEBHOOK_RATE_LIMIT_MAX=120
WEBHOOK_RATE_LIMIT_WINDOW_S=60
# N7.3: política do rate limit do webhook. Diferente das quotas, o default é
# `true` (o bloqueio 429 já vale desde a N4.4 e desligá-lo abriria a ingestão);
# ponha `false` só para calibrar MAX numa janela de observação — nela o excesso
# é medido e auditado, mas a requisição passa.
WEBHOOK_RATE_LIMIT_ENFORCE=true
RUNTIME_API_RATE_LIMIT_MAX=300
RUNTIME_API_RATE_LIMIT_WINDOW_S=60

