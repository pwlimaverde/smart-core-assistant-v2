# =============================================================================
# Observabilidade — destino dos alertas
# =============================================================================
# Copie para `.env` NESTA pasta e preencha antes de depender do alerting.
#
#   cp .env.example .env && docker compose --env-file .env up -d
#
# Sem isto a stack sobe igual (o compose tem defaults), mas os alertas não
# chegam a lugar nenhum: as regras disparam, o contact point aponta para um
# endereço inexistente e o incidente passa em silêncio. Era exatamente esse o
# estado anterior — roteamento provisionado, entrega em nenhum canal.
# =============================================================================

# Caminho de menor atrito: um webhook de Discord, Slack, n8n ou similar aceita
# POST com JSON sem depender de servidor de e-mail (que o projeto não tem).
# Enquanto ficar no valor de exemplo abaixo, NENHUM alerta é entregue.
SMARTCORE_ALERTA_WEBHOOK_URL=http://localhost:9/alerta-nao-configurado

# E-mail de plantão. Só entrega se o SMTP abaixo estiver configurado.
SMARTCORE_ALERTA_EMAIL=ops@smartcore.local

# SMTP do Grafana. Deixe `false` se for usar só o webhook.
GF_SMTP_ENABLED=false
GF_SMTP_HOST=
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=
