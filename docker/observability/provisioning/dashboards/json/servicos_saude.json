      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "100 * sum by (service_name) (rate(smartcore_rpc_total{error=\"true\"}[5m])) / sum by (service_name) (rate(smartcore_rpc_total[5m]))",
