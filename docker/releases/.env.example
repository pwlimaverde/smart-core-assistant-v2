# Releases Server Configuration (.env)
# Copy to .env and fill in actual values
# NEVER commit .env to git (it contains secrets)

# Upload token for CI/CD pipeline (GitHub Actions)
# Generate with: openssl rand -hex 32
RELEASES_UPLOAD_TOKEN=your-secure-token-here

# Rust logging level
RUST_LOG=releases_server=info,tower_http=debug

# Releases directory (host path)
# Will be mounted to /data/releases in container
RELEASES_HOST_PATH=/opt/smartcore/releases
