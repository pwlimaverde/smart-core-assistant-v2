# Smart Core Releases Server — variáveis de ambiente
# Copie para .env e preencha (NUNCA commitar o .env; permissão 600 — achado G6)

# Token do CI para POST /upload (secret RELEASES_UPLOAD_TOKEN no GitHub).
# Gerar: openssl rand -hex 32
RELEASES_UPLOAD_TOKEN=

# Segredo HMAC dos tickets de download. IGUAL ao RELEASES_DOWNLOAD_SECRET do .env
# do control_plane (que assina); aqui só se verifica. Vazio = downloads recusados.
# Gerar: openssl rand -hex 32
RELEASES_DOWNLOAD_SECRET=

# Limite do corpo do upload (MB).
RELEASES_MAX_UPLOAD_MB=500
