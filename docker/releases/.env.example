# Smart Core Releases Server — Environment variables
# Copy to .env and fill with real values (NEVER commit .env)

# Token para autenticação de upload (CI/CD)
# Gerar: openssl rand -hex 32
RELEASES_UPLOAD_TOKEN=your-secure-upload-token-here

# Segredo para assinar/validar tickets de download (HMAC-SHA256)
# Deve ser igual nos dois lados (control_plane assina, releases_server valida)
# Gerar: openssl rand -hex 32
RELEASES_DOWNLOAD_SECRET=your-secure-download-secret-here
