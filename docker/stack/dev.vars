# Topologia da DEV — interpolação do compose, SEM segredo (versionado).
# Lido depois do dev.env: o que está aqui vence. Segredos ficam no secret
# ENV_FILE_B64 do environment `dev` (materializado em /opt/smartcore/dev/env/dev.env).
STACK_PROJETO=smart-core-v2-dev
OBS_NET=smart_core_v2_observability
MCP_TELEMETRIA_NET=smart_core_v2_mcp_telemetria
RUNTIME_WEB_PORT=50051
WEB_HOST_PORT=8081
WEB_TENANT_HOST_PORT=8083
MCP_OAUTH_HOST_PORT=8095
MCP_HOST_PORT=8099
WEBHOOK_INGRESS_PORT=9210
BACKUP_INTERVALO_SEGUNDOS=86400
BACKUP_RETENCAO_DIAS=14
BACKUP_RETENCAO_MAX_ARQUIVOS=60

# -----------------------------------------------------------------------------
# Memória — decisão D1 (2026-11-22), ver prod.vars
# -----------------------------------------------------------------------------
# A dev é descartável: tetos menores e a MAIOR prioridade de OOM do host. Se a
# VPS ficar sem memória, o kernel mata containers da dev antes de tocar na prod.
# Os dois redis ficam em 256m: o `--maxmemory 150mb` precisa caber no teto.
OOM_SCORE_ADJ=900
MEM_POSTGRES=512m
MEM_REDIS=256m
MEM_BACKUP=128m
MEM_DATA_POSTGRES=256m
MEM_DATA_REDIS=192m
MEM_DATA_STORAGE=256m
MEM_CONTROL_PLANE=192m
MEM_IA_ENGINE=768m
MEM_IA_ENGINE_JEV=512m
MEM_MCP_SERVER=384m
MEM_WORKER=384m
MEM_RUNTIME_API=256m
MEM_WEB=128m
MEM_DATA_WHATSAPP=256m
MEM_WEBHOOK_INGRESS=192m
MEM_WATCHDOG=96m
MEM_MINIO=384m
