# Topologia da PROD — interpolação do compose, SEM segredo (versionado).
# Lido depois do prod.env: o que está aqui vence. Segredos ficam no secret
# ENV_FILE_B64 do environment `prod` (materializado em /opt/smartcore/prod/env/prod.env).
#
# Portas próprias (C3 do go-live): dev e prod publicam no mesmo 172.17.0.1, então
# nenhuma pode repetir a da dev. As rotas de prod no docker/edge/Caddyfile
# apontam para estes números.
STACK_PROJETO=smart-core-v2-prod
OBS_NET=smart_core_v2_telemetria_prod
MCP_TELEMETRIA_NET=smart_core_v2_mcp_telemetria_prod
RUNTIME_WEB_PORT=50052
WEB_HOST_PORT=8082
WEB_TENANT_HOST_PORT=8084
MCP_OAUTH_HOST_PORT=8096
MCP_HOST_PORT=8100
WEBHOOK_INGRESS_PORT=9211
BACKUP_INTERVALO_SEGUNDOS=43200
BACKUP_RETENCAO_DIAS=30
BACKUP_RETENCAO_MAX_ARQUIVOS=90

# -----------------------------------------------------------------------------
# Memória — decisão D1 (2026-11-22)
# -----------------------------------------------------------------------------
# VPS: 7,8 GiB de RAM + 2 GiB de swap para dev + prod + observabilidade +
# Evolution + borda. Os tetos antigos (defaults da base) somavam ~9,5 GiB SÓ na
# prod. Calibração: pico medido no cgroup (memory.peak) com folga generosa —
# Rust ~10 MiB, Python ~150 MiB, postgres ~60 MiB em 2026-11-22.
#
# Regra: a soma dos tetos da PROD cabe na RAM sozinha (~7,6 GiB). Dev e
# observabilidade têm tetos próprios e, além disso, `oom_score_adj` maior: se a
# máquina inteira ficar sem memória, o kernel mata a dev primeiro, depois a
# observabilidade, e só por último a prod.
OOM_SCORE_ADJ=0
MEM_POSTGRES=1g
MEM_REDIS=256m
MEM_BACKUP=256m
MEM_DATA_POSTGRES=384m
MEM_DATA_REDIS=256m
# data_storage repassa upload de mídia ao R2: folga para arquivos grandes.
MEM_DATA_STORAGE=384m
MEM_CONTROL_PLANE=256m
MEM_IA_ENGINE=1536m
MEM_IA_ENGINE_JEV=768m
MEM_MCP_SERVER=512m
MEM_WORKER=512m
MEM_RUNTIME_API=384m
MEM_WEB=128m
MEM_DATA_WHATSAPP=384m
MEM_WEBHOOK_INGRESS=256m
MEM_WATCHDOG=128m
