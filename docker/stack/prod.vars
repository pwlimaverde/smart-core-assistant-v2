# Topologia da PROD — interpolação do compose, SEM segredo (versionado).
# Lido depois do prod.env: o que está aqui vence. Segredos ficam no secret
# ENV_FILE_B64 do environment `prod` (materializado em /opt/smartcore/prod/env/prod.env).
#
# Portas próprias (C3 do go-live): dev e prod publicam no mesmo 172.17.0.1, então
# nenhuma pode repetir a da dev. As rotas de prod no docker/edge/Caddyfile
# apontam para estes números.
STACK_PROJETO=smart-core-v2-prod
OBS_NET=smart_core_v2_telemetria_prod
MCP_TELEMETRIA_NET=smart_core_v2_mcp_telemetria_prod
RUNTIME_WEB_PORT=50052
WEB_HOST_PORT=8082
WEB_TENANT_HOST_PORT=8084
MCP_OAUTH_HOST_PORT=8096
MCP_HOST_PORT=8100
WEBHOOK_INGRESS_PORT=9211
BACKUP_INTERVALO_SEGUNDOS=43200
BACKUP_RETENCAO_DIAS=30
BACKUP_RETENCAO_MAX_ARQUIVOS=90
