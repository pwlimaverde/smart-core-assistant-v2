[Unit]
Description=SmartCore DEV — control_plane
Documentation=https://github.com/pwlimaverde/smart-core-assistant-v2
After=smartcore-dev-data_postgres.service smartcore-dev-data_redis.service
Requires=smartcore-dev-data_postgres.service smartcore-dev-data_redis.service

[Service]
Type=simple
User=smartcore
Group=smartcore
WorkingDirectory=/opt/smartcore/dev
EnvironmentFile=/opt/smartcore/dev/.env
ExecStart=/opt/smartcore/dev/bin/control_plane
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smartcore-dev-control_plane
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=smartcore-dev.target
