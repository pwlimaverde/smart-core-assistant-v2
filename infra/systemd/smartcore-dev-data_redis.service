[Unit]
Description=SmartCore DEV — data_redis
Documentation=https://github.com/pwlimaverde/smart-core-assistant-v2
After=network.target docker.service

[Service]
Type=simple
User=smartcore
Group=smartcore
WorkingDirectory=/opt/smartcore/dev
EnvironmentFile=/opt/smartcore/dev/.env
ExecStart=/opt/smartcore/dev/bin/data_redis
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smartcore-dev-data_redis
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=smartcore-dev.target
