[Unit]
Description=SmartCore DEV — runtime_api (gRPC gateway)
Documentation=https://github.com/seu-org/smart-core-assistant-v2
After=smartcore-dev-data_postgres.service smartcore-dev-data_redis.service \
      smartcore-dev-data_storage.service smartcore-dev-control_plane.service \
      smartcore-dev-messaging_gateway.service smartcore-dev-worker.service
Requires=smartcore-dev-data_postgres.service smartcore-dev-data_redis.service

[Service]
Type=simple
User=smartcore
Group=smartcore
WorkingDirectory=/opt/smartcore/dev
EnvironmentFile=/opt/smartcore/dev/.env
ExecStart=/opt/smartcore/dev/bin/runtime_api
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smartcore-dev-runtime_api
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=smartcore-dev.target
