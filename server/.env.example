# Copie para server/.env e preencha antes de rodar sqlx migrate run / cargo sqlx prepare.
# Abra o túnel SSH primeiro: cd infra && .\tunnel.ps1
# Confirme a porta mapeada pelo tunnel (ajuste 5432 se necessário).
DATABASE_URL=postgresql://smartcore_app:SENHA@localhost:5432/smartcore_v2

# Chave AES-256 para criptografia de API keys (32 bytes em base64)
# Gerar: openssl rand -base64 32
ENCRYPTION_KEY=

# Autenticação (doc 09 §6.5). JWT_SECRET é OBRIGATÓRIA (>= 32 bytes) — sem fallback.
# Gerar: openssl rand -base64 48
JWT_SECRET=
AUTH_ACCESS_TTL_S=900
AUTH_REFRESH_TTL_S=604800
# Formato "N/Ms": N tentativas de login por janela de M segundos (por e-mail)
AUTH_LOGIN_RATE_LIMIT=5/60s

# Redis (via tunnel SSH; mesmo serviço do docker/compose/data.yml)
# Os testes de integração usam o banco lógico 15 (REDIS_URL + "/15").
REDIS_URL=redis://:SENHA@localhost:6379
REDIS_BUS_URL=redis://:SENHA@localhost:6380

# Usado na fase de testes (mesma URL, banco real)
RUST_LOG=debug

# Storage de mídia (data_storage / infrastructure_storage) — Cloudflare R2.
# As credenciais reais ficam em infra/.env.deploy. Preencha aqui apenas se for
# rodar os testes de integração de storage (opt-in) ou o data_storage localmente.
# O bucket é provisionado no painel do R2 (a aplicação não cria bucket).
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=media-smart-core-assistant
S3_FORCE_PATH_STYLE=true

# Superusuário padrão (bootstrap). O CLI envia ao data_postgres via RPC:
#   cargo run -p control_plane -- create-superuser
# Também aceita as flags --username/--email/--password.
SUPERUSER_USERNAME=
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=
