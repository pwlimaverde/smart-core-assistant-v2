// Generated from errors.proto

namespace smartcore.contracts;

enum ErrorCategory : int {
  ERROR_CATEGORY_UNSPECIFIED = 0,
  VALIDATION = 1,
  AUTH = 2,
  PERMISSION = 3,
  CONFLICT = 4,
  NOT_FOUND = 5,
  RATE_LIMIT = 6,
  DEPENDENCY = 7,
  TIMEOUT = 8,
  INTERNAL = 9,
}

enum Severity : int {
  SEVERITY_UNSPECIFIED = 0,
  SEVERITY_INFO = 1,
  SEVERITY_WARNING = 2,
  SEVERITY_ERROR = 3,
  SEVERITY_CRITICAL = 4,
}

table KeyValue {
  key:string;
