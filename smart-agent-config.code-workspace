{
	"folders": [
		{
			"path": "smart-agent-config"
		},
		{
			"path": "old"
		},
		{
			"name": "smart-core-assistant-v2",
			"path": "."
		}
	],
	"settings": {
		// O app Flutter (clients/apps/smart-core-admin) fica no nível 3 a partir
		// da raiz do repo. O default do Dart-Code não alcança essa profundidade e
		// classifica o workspace como "Dart-only", impedindo o launch do Flutter.
		"dart.projectSearchDepth": 6
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "smart-core-admin (dev · Chrome)",
				"request": "launch",
				"type": "dart",
				"program": "${workspaceFolder:smart-core-assistant-v2}/clients/apps/smart-core-admin/lib/main_dev.dart",
				"cwd": "${workspaceFolder:smart-core-assistant-v2}/clients/apps/smart-core-admin",
				"deviceId": "chrome",
				"args": [
					"--dart-define=SMARTCORE_API_ENDPOINT=https://dev.smartcoreassistant.com.br"
				]
			}
		]
	}
}